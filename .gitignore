# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# SPICE kernels (download with scripts/download_kernels.py)
data/kernels/*.bsp
data/kernels/*.tls
data/kernels/*.tls.pc
data/kernels/*.tm
data/kernels/*.partial
data/kernels/*.tpc
data/kernels/*.tf
data/kernels/*.tsc

# Generated products (porkchop CSV/HTML, plots — regenerate locally)
outputs/*
!outputs/.gitkeep
!outputs/README.md

# Secrets (none expected in Stage 1; keep the pattern)
.env
.env.*
*.pem
*.key

# Local tool caches (not part of ARES)
agent-tools/

# Local packaging copy (not part of the source tree)
Downloads/

# Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.log

# Keep example env files
!.env.example
!frontend/.env.example
